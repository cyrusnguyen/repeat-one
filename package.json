    "postinstall": "prisma generate",
    "demo:reset": "node scripts/reset-demo.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.56.0",
    "next": "^16.4.0",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
