# Server-side only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
DATABASE_URL="file:../data/repeatone.db"

# URL prefixes the browser may load (comma-separated). Anything else is blocked at the network layer.
ALLOWED_URL_PREFIXES=http://localhost:3000/demo/

# Per-plan model limits (planning is the only step that calls Opus).
MAX_MODEL_CALLS=12
MAX_PLAN_COST_USD=1.00

# Per-run limits.
MAX_RUN_STEPS=30
RUN_TIMEOUT_MS=60000

# Set to false to watch the browser while it runs.
HEADLESS=true
