# Server-side only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
DATABASE_URL="file:../data/repeatone.db"

# URL prefixes the browser may load (comma-separated). Everything else is blocked at the network layer.
ALLOWED_URL_PREFIXES=http://localhost:3000/demo/

# Model ceilings, applied per plan and per run (planning and recovery are the only model calls).
MAX_MODEL_CALLS=12
MAX_PLAN_COST_USD=1.00

# Run ceilings.
MAX_RUN_STEPS=30
RUN_TIMEOUT_MS=180000
MAX_RECOVERY_ATTEMPTS=3
APPROVAL_TIMEOUT_MS=300000

# Set to false to watch the browser while it runs.
HEADLESS=true
